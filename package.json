{
  "name": "application-tracker",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev -p 6677",
    "build": "next build",
    "start": "next start",
    "lint": "eslint",
    "typecheck": "next typegen && tsc --noEmit",
    "test": "vitest run",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "drizzle-kit migrate",
    "ingest": "node --conditions=react-server --env-file-if-exists=.env.local --import tsx scripts/ingest.ts",
    "seed:companies": "node --conditions=react-server --env-file-if-exists=.env.local --import tsx scripts/seed-companies.ts",
    "seed:claims": "node --conditions=react-server --env-file-if-exists=.env.local --import tsx scripts/seed-claims.ts",
    "seed:answers": "node --conditions=react-server --env-file-if-exists=.env.local --import tsx scripts/seed-answers.ts"
  },
  "dependencies": {
    "@clerk/mcp-tools": "0.6.0",
    "@clerk/nextjs": "^7.9.12",
    "@modelcontextprotocol/server": "2.3.1",
    "@radix-ui/react-select": "2.3.7",
    "@react-pdf/renderer": "^4.9.0",
    "@supabase/supabase-js": "^2.117.3",
    "drizzle-orm": "^0.45.4",
    "htmlparser2": "^12.0.0",
    "mcp-handler": "2.3.0",
    "next": "16.4.0",
    "postgres": "^3.4.9",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "react-markdown": "^10.1.0",
    "server-only": "^0.0.1",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@tailwindcss/turbopack": "^4",
    "@types/node": "^22",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "drizzle-kit": "^0.31.11",
    "eslint": "^9",
    "eslint-config-next": "16.4.0",
    "tailwindcss": "^4",
    "tsx": "^4.23.15",
    "typescript": "^5",
    "vitest": "^5.0.3"
  },
  "packageManager": "pnpm@11.22.0"
}
